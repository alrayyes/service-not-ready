{
	# Nothing here needs the admin API, so don't listen on :2019. Caddy still autosaves its
	# config to /config and keeps state under /data, so both need a writable tmpfs.
	admin off
}

:{$LISTEN_PORT:8080} {
	root * /srv

	# Every path, every method and every Host is "not ready". `error` hands the request to
	# handle_errors, which is the only place that can serve a file with a non-200 status.
	error "service not ready" 503

	handle_errors {
		rewrite * /503.html
		encode zstd gzip
		file_server

		header {
			# A fallback must never be cached, or the page outlives the outage it reports.
			Cache-Control "no-store"
			Retry-After "{$RETRY_AFTER:30}"
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			# The page is one file with inline style and script and talks only to itself.
			Content-Security-Policy "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
			-Server
		}
	}
}
