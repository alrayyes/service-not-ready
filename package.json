{
	"name": "service-not-ready",
	"version": "0.4.2",
	"private": true,
	"description": "The 503 'service not ready' fallback page, as a hardened Caddy image.",
	"license": "GPL-3.0-only",
	"scripts": {
		"build": "bun scripts/build-pages.ts",
		"build:check": "bun scripts/build-pages.ts --check",
		"format": "biome check --write .",
		"format:md": "prettier --write '**/*.md'",
		"format:yaml": "prettier --write '**/*.{yml,yaml}'",
		"lint": "biome check .",
		"lint:md:format": "prettier --check '**/*.md'",
		"lint:md:grammar": "scripts/lint-grammar.sh",
		"lint:md:structure": "markdownlint-cli2 '**/*.md'",
		"lint:yaml:format": "prettier --check '**/*.{yml,yaml}'",
		"prepare": "lefthook install",
		"screenshot": "bun scripts/screenshot.ts",
		"sort": "sort-package-json --check",
		"test": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"overrides": {
		"basic-ftp": "6.2.2",
		"js-yaml": "5.4.3",
		"katex": "0.19.0",
		"smol-toml": "1.9.0",
		"tmp": "0.2.7",
		"uuid": "11.1.1"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@lhci/cli": "0.15.1",
		"@playwright/test": "1.64.0",
		"@types/bun": "1.4.2",
		"@types/node": "26.6.4",
		"lefthook": "2.2.0",
		"markdownlint-cli2": "0.23.3",
		"prettier": "3.9.9",
		"sort-package-json": "4.0.0",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.3.14"
}
