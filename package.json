{
	"name": "service-not-ready",
	"version": "0.3.0",
	"private": true,
	"description": "The 503 'service not ready' fallback page, as a hardened Caddy image.",
	"license": "GPL-3.0-only",
	"scripts": {
		"build": "bun scripts/build-pages.ts",
		"build:check": "bun scripts/build-pages.ts --check",
		"format": "biome check --write .",
		"lint": "biome check .",
		"prepare": "lefthook install",
		"screenshot": "bun scripts/screenshot.ts",
		"sort": "sort-package-json --check",
		"test": "playwright test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@playwright/test": "1.63.0",
		"@types/bun": "1.3.14",
		"@types/node": "26.6.4",
		"lefthook": "2.1.17",
		"sort-package-json": "4.0.0",
		"typescript": "7.0.2"
	},
	"packageManager": "bun@1.3.14"
}
